  <application android:name=".NemesisApplication" android:allowBackup="false" android:label="NEMESIS" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:usesCleartextTraffic="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <service android:name=".NemesisService" android:exported="false" />
